{
  "name": "stepwise-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../compiler-wasm --target web --out-dir ../web/pkg --no-pack",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
