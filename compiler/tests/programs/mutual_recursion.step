// expect: true
// expect: true
// expect: false
fn is_even(n: int) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: int) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn main() {
    print(is_even(10));
    print(is_odd(7));
    print(is_even(3));
}
