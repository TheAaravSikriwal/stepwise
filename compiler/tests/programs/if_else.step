// expect: 1
// expect: -1
// expect: 0
// expect: 200
fn sign(n: int) -> int {
    if n > 0 {
        return 1;
    } else if n < 0 {
        return -1;
    } else {
        return 0;
    }
}

fn main() {
    print(sign(42));
    print(sign(-7));
    print(sign(0));
    let x = 3;
    if x > 5 {
        print(100);
    }
    if x < 5 {
        print(200);
    } else {
        print(300);
    }
}
