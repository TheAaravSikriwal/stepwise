fn main() {
    print(1 < 2);
    print(2 <= 2);
    print(3 > 4);
    print(3 >= 4);
    print(5 == 5);
    print(5 != 5);
    print(true == false);
    print(!true);
    print(1 < 2 && 2 < 3);
    print(1 > 2 || 2 > 3);
}
