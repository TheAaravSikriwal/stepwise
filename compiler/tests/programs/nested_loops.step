// expect: 1
// expect: 12
// expect: 123
fn main() {
    let mut row = 1;
    while row <= 3 {
        let mut col = 1;
        let mut digits = 0;
        while col <= row {
            digits = digits * 10 + col;
            col = col + 1;
        }
        print(digits);
        row = row + 1;
    }
}
