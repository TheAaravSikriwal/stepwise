// expect: 0
// expect: 8
// expect: 111
fn steps(start: int) -> int {
    let mut n = start;
    let mut count = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    return count;
}

fn main() {
    print(steps(1));
    print(steps(6));
    print(steps(27));
}
