// expect: 7
// expect: 11
// expect: 13
// expect: 17
// expect: 19
// expect: 23
// expect: 29
// expect: 10
fn is_prime(n: int) -> bool {
    if n < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn main() {
    let mut n = 1;
    let mut count = 0;
    while n <= 30 {
        if is_prime(n) {
            print(n);
            count = count + 1;
        }
        n = n + 1;
    }
    print(count);
}
