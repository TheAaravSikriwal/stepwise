// Fibonacci with recursion. Watch the call stack grow and shrink:
// each call to `fib` gets its own `n`.
fn fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    let mut i = 0;
    while i <= 6 {
        print(fib(i));
        i = i + 1;
    }
}
